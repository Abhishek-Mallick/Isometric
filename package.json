{
  "name": "isometric",
  "version": "0.1.0",
  "private": true,
  "description": "Isometric line figures and UI primitives for React. Installable with the shadcn CLI.",
  "homepage": "https://isometric.buildlab.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhishek-Mallick/isometric"
  },
  "bugs": "https://github.com/Abhishek-Mallick/isometric/issues",
  "license": "MIT",
  "author": "Abhishek Mallick",
  "keywords": [
    "isometric",
    "svg",
    "illustration",
    "line-art",
    "react",
    "tailwindcss",
    "shadcn",
    "shadcn-registry",
    "radix-ui",
    "components"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm registry:gen && next dev",
    "build": "pnpm check:names && pnpm registry:build && next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:names": "node scripts/check-names.mjs",
    "registry:gen": "node scripts/generate-registry.mts",
    "registry:build": "pnpm registry:gen && shadcn build",
    "registry:validate": "shadcn registry validate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  }
}
